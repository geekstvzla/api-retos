extends ../../layout

block head_styles
    style.
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
        }
        .info-table td {
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
            color: #334155;
        }
        .info-table tr:last-child td {
            border-bottom: none;
        }
        .info-table td.label {
            font-weight: 600;
            color: #64748b;
            width: 40%;
            background-color: #f8fafc;
        }
        .badge-pill {
            display: inline-block;
            padding: 4px 12px;
            font-size: 13px;
            font-weight: 600;
            border-radius: 20px;
        }
        .badge-success {
            background-color: #ecfdf5;
            color: #059669;
            border: 1px solid #a7f3d0;
        }
        .badge-info {
            background-color: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }

block content
    if isModification
        h2(style="color: #0f172a; margin-top: 0;") 📝 Comprobante de cuota modificado
        p.message
            | El participante #[strong #{userName}] (Inscripción #[strong ##{enrollNumber}]) ha #[strong modificado el comprobante de pago] correspondiente a: #[strong #{installmentsLabel}].
    else
        h2(style="color: #0f172a; margin-top: 0;") 💳 #{isAdvance ? '¡Pago de cuotas adelantadas reportado!' : '¡Nuevo pago de cuota reportado!'}
        p.message
            | El participante #[strong #{userName}] (Inscripción #[strong ##{enrollNumber}]) ha #[strong reportado el pago] de: #[strong #{installmentsLabel}].

    p.message(style="margin-bottom: 10px;")
        | #[strong Evento:] #{eventTitle} | #[strong Edición:] #{eventEdition}

    table.info-table(cellpadding="0" cellspacing="0")
        tr
            td.label Cuota(s) reportada(s)
            td #[strong #{installmentsLabel}]
        if isAdvance
            tr
                td.label Tipo de reporte
                td
                    span.badge-pill.badge-info Adelanto de cuotas en un solo comprobante
        tr
            td.label N° de Operación / Referencia
            td #[strong #{operationNumber}]
        tr
            td.label Fecha de pago
            td= paymentDay
        tr
            td.label Método de pago
            td= paymentMethod
        if amount
            tr
                td.label Monto total reportado
                td(style="font-size: 16px; color: #16a34a; font-weight: bold;")
                    | #{currencySymbol || '$'} #{amount}

    p.message(style="margin-top: 20px; font-size: 13px; color: #64748b;")
        | Se ha adjuntado el comprobante de pago a este correo para tu revisión y validación administrativa.
