extends ../../layout

block head_styles
    style
        include ../../../assets/css/emails/newUserEnroll.css

block content
    h2 Congratulations, you have a new registration! 🥳
    
    p.message
        | The participant #[strong #{userName}] has registered for your event #[strong #{eventTitle}] with the registration number #[strong #{enrollNumber}].

    if paymentInstallments && paymentInstallments > 1
        div(style="margin-top: 20px; padding: 15px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;")
            p(style="margin: 0; font-weight: bold; color: #1e293b; font-size: 15px;")
                | 💳 Participant's Installment Payment Plan:
            if hasCustomInstallments && installmentsBreakdown && installmentsBreakdown.length > 0
                p(style="margin: 5px 0 6px 0; color: #475569; font-size: 14px;")
                    | The participant chose to pay the registration in #[strong #{paymentInstallments} installments]:
                ul(style="margin: 0 0 10px 20px; padding: 0; color: #334155; font-size: 13px;")
                    each inst in installmentsBreakdown
                        li(style="margin-bottom: 4px;")
                            | Installment #{inst.number}#{inst.percentageLabel ? ' (' + inst.percentageLabel + ')' : ''}: #[strong #{currencySymbol || '$'} #{inst.formattedAmount}]
            else
                p(style="margin: 5px 0 0 0; color: #475569; font-size: 14px;")
                    | The participant chose to pay the registration in #[strong #{paymentInstallments} installments] of #[strong #{currencySymbol || '$'} #{installmentAmount}] each.

    if purchasedAccessories && purchasedAccessories.length > 0
        p.message(style="margin-top: 20px; font-weight: bold;")
            | Additional purchased items / accessories:
        table.table(cellpadding="0" cellspacing="0" width="100%" style="margin-top: 15px; margin-bottom: 25px;")
            thead
                tr
                    th Product
                    th Quantity
            tbody
                each acc in purchasedAccessories
                    tr
                        td= acc.title || acc.product_title || 'Accessory'
                        td= acc.quantity || acc.qty || 1
